{
  "name": "language-loop",
  "version": "1.0.0",
  "private": true,
  "description": "Learn foreign languages through audio repetition",
  "scripts": {
    "start": "serve -l 8080 .",
    "dev": "serve -l 8080 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint js tests",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" \"*.json\" \"*.md\"",
    "app:install": "npm --prefix app install",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "app:preview": "npm --prefix app run preview",
    "app:test": "npm --prefix app run test",
    "app:lint": "npm --prefix app run lint"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "serve": "^14.0.0",
    "vitest": "^2.0.0"
  }
}
